+void TWFunc::RotationByArKT()
+{
+    std::thread([] {
+        std::string cur = android::base::GetProperty("persist.twrp.rotation", "0");
+        int next_rot = (std::stoi(cur) + 90) % 360;
+
+        std::string next_rot_str = std::to_string(next_rot);
+        android::base::SetProperty("persist.twrp.rotation", next_rot_str);
+
+        Exec_Cmd("mkdir -p /metadata/TWRP /twres/twres-arkt");
+        TWFunc::write_to_file("/metadata/TWRP/rotation_state", next_rot_str);
+        TWFunc::write_to_file("/twres/twres-arkt/rotation_state", next_rot_str);
+
+        chdir("/");
+        umask(022);
+        SwapXmlByArKT();
+
+        DataManager::Flush();
+        sync();
+
+        gr_reload_rotation();
+        PageManager::RequestReload();
+
+        int future_rot = (next_rot + 90) % 360;
+        DataManager::SetValue("arkt_next_rotation", GetRotationNameByArKT(future_rot));
+    }).detach();
+}
