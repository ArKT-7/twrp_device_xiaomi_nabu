+void gr_fill_round(int x, int y, int w, int h, int r)
+{
+    r = std::min(r, std::min(w, h) / 2);
+    if (r <= 0) {
+        gr_fill(x, y, w, h);
+        return;
+    }
+
+    // square middle part first, then the four corners one row at a time
+    if (h > 2 * r) {
+        gr_fill(x, y + r, w, h - 2 * r);
+    }
+
+    for (int row = 0; row < r; row++) {
+        // how far the middlle of this row is from the centre of the corner circle
+        float dy = r - row - 0.5f;
+        int inset = r - (int)(sqrtf(r * r - dy * dy) + 0.5f);
+
+        gr_fill(x + inset, y + row, w - 2 * inset, 1);
+        gr_fill(x + inset, y + h - 1 - row, w - 2 * inset, 1);
+    }
+}
