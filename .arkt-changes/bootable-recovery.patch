+
+static bool allocate_blur_buffers(size_t required_bytes, int scaled_width) {
+    if (blur_state.allocated_size < required_bytes) {
+        free(blur_state.cache_buffer);
+        free(blur_state.tmp_buffer);
+        blur_state.cache_buffer = (unsigned char*)malloc(required_bytes);
+        blur_state.tmp_buffer = (unsigned char*)malloc(required_bytes);
+        blur_state.allocated_size = (blur_state.cache_buffer && blur_state.tmp_buffer) ? required_bytes : 0;
+        blur_state.is_valid = false;
+    }
+
+    if (blur_state.sums_width < scaled_width) {
+        free(blur_state.column_sums);
+        blur_state.column_sums = (BlurColorSum*)malloc(scaled_width * sizeof(BlurColorSum));
+        blur_state.sums_width = blur_state.column_sums ? scaled_width : 0;
+    }
+    return blur_state.allocated_size >= required_bytes && blur_state.sums_width >= scaled_width;
+}
+
+static void process_blur_rows(const unsigned char* src, unsigned char* dst, int width, int height, int radius, int weight_inverse) {
+    for (int y = 0; y < height; y++) {
+        const unsigned char* in_row = src + y * width * 4;
+        unsigned char* out_row = dst + y * width * 4;
+        int r_sum = 0, g_sum = 0, b_sum = 0;
+
+        for (int k = -radius; k <= radius; k++) {
+            int clamped_x = clamp_int(k, 0, width - 1);
+            const unsigned char* pixel = in_row + clamped_x * 4;
+            r_sum += pixel[0]; g_sum += pixel[1]; b_sum += pixel[2];
+        }
+
+        for (int x = 0; x < width; x++) {
+            out_row[0] = (r_sum * weight_inverse + 0x8000) >> 16;
+            out_row[1] = (g_sum * weight_inverse + 0x8000) >> 16;
+            out_row[2] = (b_sum * weight_inverse + 0x8000) >> 16;
+            out_row += 4;
+
+            int leading_x = clamp_int(x + radius + 1, 0, width - 1);
+            int trailing_x = clamp_int(x - radius, 0, width - 1);
+
+            const unsigned char* pixel_add = in_row + leading_x * 4;
+            const unsigned char* pixel_sub = in_row + trailing_x * 4;
+
+            r_sum += pixel_add[0] - pixel_sub[0];
+            g_sum += pixel_add[1] - pixel_sub[1];
+            b_sum += pixel_add[2] - pixel_sub[2];
+        }
+    }
+}
+
+static void process_blur_columns(const unsigned char* src, unsigned char* dst, BlurColorSum* col_sums, int width, int height, int radius, int weight_inverse) {
+    for (int x = 0; x < width; x++)
+        col_sums[x] = {0, 0, 0};
+
+    for (int k = -radius; k <= radius; k++) {
+        int clamped_y = clamp_int(k, 0, height - 1);
+        const unsigned char* pixel = src + clamped_y * width * 4;
+        for (int x = 0; x < width; x++, pixel += 4) {
+            col_sums[x].r += pixel[0];
+            col_sums[x].g += pixel[1];
+            col_sums[x].b += pixel[2];
+        }
+    }
+
+    for (int y = 0; y < height; y++) {
+        unsigned char* out_row = dst + y * width * 4;
+
+        int leading_y = clamp_int(y + radius + 1, 0, height - 1);
+        int trailing_y = clamp_int(y - radius, 0, height - 1);
+
+        const unsigned char* row_add = src + leading_y * width * 4;
+        const unsigned char* row_sub = src + trailing_y * width * 4;
+
+        for (int x = 0; x < width; x++, out_row += 4, row_add += 4, row_sub += 4) {
+            out_row[0] = (col_sums[x].r * weight_inverse + 0x8000) >> 16;
+            out_row[1] = (col_sums[x].g * weight_inverse + 0x8000) >> 16;
+            out_row[2] = (col_sums[x].b * weight_inverse + 0x8000) >> 16;
+
+            col_sums[x].r += row_add[0] - row_sub[0];
+            col_sums[x].g += row_add[1] - row_sub[1];
+            col_sums[x].b += row_add[2] - row_sub[2];
+        }
+    }
+}
