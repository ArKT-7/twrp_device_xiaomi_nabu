+void TWFunc::PersistRotationByArKT()
+{
+    PartitionManager.Mount_By_Path("/metadata", false);
+
+    std::string rot_str, ram_str;
+    if (TWFunc::read_file("/metadata/TWRP/rotation_state", rot_str) != 0 || rot_str.empty()) rot_str = "0";
+    if (TWFunc::read_file("/twres/twres-arkt/rotation_state", ram_str) != 0 || ram_str.empty()) ram_str = "0";
+
+    int saved = atoi(rot_str.c_str());
+    if (saved != 90 && saved != 180 && saved != 270) saved = 0;
+
+    int next = (saved + 90) % 360;
+    DataManager::SetValue("arkt_next_rotation", GetRotationNameByArKT(next));
+
+    property_set("persist.twrp.rotation", std::to_string(saved).c_str());
+    Exec_Cmd("mkdir -p /twres/twres-arkt");
+    TWFunc::write_to_file("/twres/twres-arkt/rotation_state", std::to_string(saved));
+
+    if ((saved == 90 || saved == 270) != (atoi(ram_str.c_str()) == 90 || atoi(ram_str.c_str()) == 270)) {
+        SwapXmlByArKT();
+    }
+
+    sync();
+}
