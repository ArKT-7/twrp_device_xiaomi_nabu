+static std::string GetRotationNameByArKT(int rot) {
+    return (rot == 0) ? "Portrait" : (rot == 90) ? "Landscape" : (rot == 180) ? "Flipped Portrait" : "Flipped Landscape";
+}
+
+void TWFunc::SwapXmlByArKT()
+{
+    const std::string swap_script = R"ArKT(
+        mkdir -p /twres/twres-arkt/backup
+
+        for f in ui.xml splash.xml portrait.xml landscape.xml images; do
+            [ -e "/twres/$f" ] && mv -f "/twres/$f" "/twres/twres-arkt/backup/"
+        done
+        
+        for f in ui.xml splash.xml portrait.xml landscape.xml images; do
+            [ -e "/twres/twres-arkt/$f" ] && mv -f "/twres/twres-arkt/$f" "/twres/"
+        done
+        
+        for f in ui.xml splash.xml portrait.xml landscape.xml images; do
+            [ -e "/twres/twres-arkt/backup/$f" ] && mv -f "/twres/twres-arkt/backup/$f" "/twres/twres-arkt/"
+        done
+
+        SHARED_IMGS="splashteamwin.png enter_terminal.png shift_terminal.png win.png main_button_half_width_low.png shift_terminal_fill.png splashlogo.png backspace_terminal.png main_button_half_width.png space_terminal.png unlock_icon.png cursor.png"
+        for img in $SHARED_IMGS; do
+            [ -f "/twres/twres-arkt/images/$img" ] && mv -f "/twres/twres-arkt/images/$img" "/twres/images/"
+        done
+
+        [ -f /ramdisk-files.txt ] && mv -f /ramdisk-files.txt /ramdisk-files-arkt-1.txt
+        [ -f /ramdisk-files-arkt.txt ] && mv -f /ramdisk-files-arkt.txt /ramdisk-files.txt
+        [ -f /ramdisk-files-arkt-1.txt ] && mv -f /ramdisk-files-arkt-1.txt /ramdisk-files-arkt.txt
+        
+        rm -rf /twres/twres-arkt/backup
+    )ArKT";
+
+    Exec_Cmd(swap_script);
+}
+
+void TWFunc::PersistRotationByArKT()
+{
+    PartitionManager.Mount_By_Path("/metadata", false);
+
+    std::string rot_str, ram_str;
+    if (TWFunc::read_file("/metadata/TWRP/rotation_state", rot_str) != 0 || rot_str.empty()) {
+        if (TWFunc::read_file("/twres/twres-arkt/rotation_state", rot_str) != 0 || rot_str.empty()) {
+            rot_str = "0";
+        }
+    }
+
+    if (TWFunc::read_file("/twres/twres-arkt/rotation_state", ram_str) != 0 || ram_str.empty()) ram_str = "0";
+
+    int saved = atoi(rot_str.c_str());
+    if (saved != 90 && saved != 180 && saved != 270) saved = 0;
+
+    int next = (saved + 90) % 360;
+    DataManager::SetValue("arkt_next_rotation", GetRotationNameByArKT(next));
+
+    property_set("persist.twrp.rotation", std::to_string(saved).c_str());
+
+    Exec_Cmd("mkdir -p /metadata/TWRP");
+    TWFunc::write_to_file("/metadata/TWRP/rotation_state", std::to_string(saved));
+
+    Exec_Cmd("mkdir -p /twres/twres-arkt");
+    TWFunc::write_to_file("/twres/twres-arkt/rotation_state", std::to_string(saved));
+
+    if ((saved == 90 || saved == 270) != (atoi(ram_str.c_str()) == 90 || atoi(ram_str.c_str()) == 270)) {
+        SwapXmlByArKT();
+    }
+
+    sync();
+}
+
+void TWFunc::RotationByArKT()
+{
+    std::thread([] {
+        std::string cur = android::base::GetProperty("persist.twrp.rotation", "0");
+        int next_rot = (std::stoi(cur) + 90) % 360;
+
+        std::string next_rot_str = std::to_string(next_rot);
+        android::base::SetProperty("persist.twrp.rotation", next_rot_str);
+
+        Exec_Cmd("mkdir -p /twres/twres-arkt");
+        TWFunc::write_to_file("/twres/twres-arkt/rotation_state", next_rot_str);
+
+        if (PartitionManager.Mount_By_Path("/metadata", false)) {
+            Exec_Cmd("mkdir -p /metadata/TWRP");
+            TWFunc::write_to_file("/metadata/TWRP/rotation_state", next_rot_str);
+        }
+
+        chdir("/");
+        umask(022);
+        if ((next_rot == 90 || next_rot == 270) != TWFunc::Path_Exists("/twres/landscape.xml")) {
+            SwapXmlByArKT();
+        }
+
+        DataManager::Flush();
+        sync();
+
+        gr_reload_rotation();
+        std::this_thread::sleep_for(std::chrono::milliseconds(200));
+        PageManager::RequestReload();
+
+        int future_rot = (next_rot + 90) % 360;
+        DataManager::SetValue("arkt_next_rotation", GetRotationNameByArKT(future_rot));
+    }).detach();
+}
+
 #endif // ndef BUILD_TWRPTAR_MAIN
