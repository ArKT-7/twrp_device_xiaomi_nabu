+            int w_btm_left = ((256 - fraction_x) * fraction_y) >> 8;
+            int w_btm_right = (fraction_x * fraction_y) >> 8;
+
+            const unsigned char* top_left = row_top + sx1 * 4;
+            const unsigned char* top_right = row_top + sx2 * 4;
+            const unsigned char* btm_left = row_btm + sx1 * 4;
+            const unsigned char* btm_right = row_btm + sx2 * 4;
+
+            out_pixel[0] = (top_left[0] * w_top_left + top_right[0] * w_top_right + btm_left[0] * w_btm_left + btm_right[0] * w_btm_right) >> 8;
