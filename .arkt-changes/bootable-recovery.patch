+void gr_blur(int radius, int exclude_y) {
+    if (radius <= 0 || blur_state.applied_this_frame || !gr_draw || gr_draw->pixel_bytes != 4)
+        return;
+
+    int start_x = 0, start_y = 0;
+    int blur_w = gr_draw->width, blur_h = gr_draw->height;
+
+    // the excluded strip is at the top of the screen as the user sees it, so
+    // it ends up on a different edge of the framebuffer for each rotation
+    if (exclude_y < 0)
+        exclude_y = 0;
+    switch (gr_rotation) {
+        case 90:
+            blur_w -= exclude_y;
+            break;
+        case 180:
+            blur_h -= exclude_y;
+            break;
+        case 270:
+            start_x = exclude_y;
+            blur_w -= exclude_y;
+            break;
+        default:
+            start_y = exclude_y;
+            blur_h -= exclude_y;
+            break;
+    }
+
+    int downsampled_w = blur_w >> BLUR_DOWNSCALE_SHIFT;
+    int downsampled_h = blur_h >> BLUR_DOWNSCALE_SHIFT;
+
+    if (downsampled_w <= 0 || downsampled_h <= 0)
+        return;
+
+    if (!allocate_blur_buffers((size_t)downsampled_w * downsampled_h * 4, downsampled_w))
+        return;
+
+    int stride = gr_draw->row_bytes;
+
+    if (!blur_state.is_valid || blur_state.radius != radius ||
+        blur_state.x_offset != start_x || blur_state.y_offset != start_y ||
+        blur_state.width != blur_w || blur_state.height != blur_h) {
+
+        for (int sy = 0; sy < downsampled_h; sy++) {
+            const unsigned char* src = gr_draw->data + (start_y + (sy << BLUR_DOWNSCALE_SHIFT)) * stride + start_x * 4;
+            unsigned char* dst = blur_state.cache_buffer + sy * downsampled_w * 4;
+
+            for (int sx = 0; sx < downsampled_w; sx++, dst += 4) {
+                const unsigned char* pixel = src + (sx << BLUR_DOWNSCALE_SHIFT) * 4;
+                dst[0] = pixel[0];
+                dst[1] = pixel[1];
+                dst[2] = pixel[2];
+                dst[3] = 255;
+            }
+        }
+
+        int scaled_radius = std::max(1, radius >> BLUR_DOWNSCALE_SHIFT);
+        int weight_inverse = (1 << 16) / (2 * scaled_radius + 1);
+
+        for (int pass = 0; pass < 2; pass++) {
+            process_blur_rows(blur_state.cache_buffer, blur_state.tmp_buffer, downsampled_w, downsampled_h, scaled_radius, weight_inverse);
+            process_blur_columns(blur_state.tmp_buffer, blur_state.cache_buffer, blur_state.column_sums, downsampled_w, downsampled_h, scaled_radius, weight_inverse);
+        }
+
+        blur_state.radius = radius;
+        blur_state.x_offset = start_x;
+        blur_state.y_offset = start_y;
+        blur_state.width = blur_w;
+        blur_state.height = blur_h;
+        blur_state.is_valid = true;
+    }
+
+    for (int y = 0; y < blur_h; y++) {
+        int fraction_y = (y << (8 - BLUR_DOWNSCALE_SHIFT)) & 255;
+        int sy1 = clamp_int(y >> BLUR_DOWNSCALE_SHIFT, 0, downsampled_h - 1);
+        int sy2 = clamp_int(sy1 + 1, 0, downsampled_h - 1);
+
+        const unsigned char* row_top = blur_state.cache_buffer + sy1 * downsampled_w * 4;
+        const unsigned char* row_btm = blur_state.cache_buffer + sy2 * downsampled_w * 4;
+        unsigned char* out_pixel = gr_draw->data + (start_y + y) * stride + start_x * 4;
+
+        for (int x = 0; x < blur_w; x++, out_pixel += 4) {
+            int fraction_x = (x << (8 - BLUR_DOWNSCALE_SHIFT)) & 255;
+            int sx1 = clamp_int(x >> BLUR_DOWNSCALE_SHIFT, 0, downsampled_w - 1);
+            int sx2 = clamp_int(sx1 + 1, 0, downsampled_w - 1);
