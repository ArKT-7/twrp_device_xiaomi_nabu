+struct BlurColorSum { int r, g, b; };
+
+static inline int clamp_int(int value, int low, int high) {
+    return value < low ? low : (value > high ? high : value);
+}
+
+static struct {
+    unsigned char* cache_buffer;
+    unsigned char* tmp_buffer;
+    size_t allocated_size;
+    BlurColorSum* column_sums;
+    int sums_width;
+    int radius, x_offset, y_offset, width, height;
+    bool is_valid;
+    bool applied_this_frame;
+} blur_state;
+
+void gr_blur_clear_cache(void) {
+    blur_state.is_valid = false;
+}
+
+// called at the start of every render pass, so stacked overlays blur only once
+void gr_blur_new_frame(void) {
+    blur_state.applied_this_frame = false;
