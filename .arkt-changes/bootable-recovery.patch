+void TWFunc::SwapXmlByArKT()
+{
+    const std::string swap_script = R"ArKT(
+        mkdir -p /twres/twres-arkt/backup
+
+        for f in ui.xml splash.xml portrait.xml landscape.xml images; do
+            [ -e "/twres/$f" ] && mv -f "/twres/$f" "/twres/twres-arkt/backup/"
+        done
+        
+        for f in ui.xml splash.xml portrait.xml landscape.xml images; do
+            [ -e "/twres/twres-arkt/$f" ] && mv -f "/twres/twres-arkt/$f" "/twres/"
+        done
+        
+        for f in ui.xml splash.xml portrait.xml landscape.xml images; do
+            [ -e "/twres/twres-arkt/backup/$f" ] && mv -f "/twres/twres-arkt/backup/$f" "/twres/twres-arkt/"
+        done
+
+        SHARED_IMGS="splashteamwin.png enter_terminal.png shift_terminal.png win.png main_button_half_width_low.png shift_terminal_fill.png splashlogo.png backspace_terminal.png main_button_half_width.png space_terminal.png unlock_icon.png cursor.png"
+        for img in $SHARED_IMGS; do
+            [ -f "/twres/twres-arkt/images/$img" ] && mv -f "/twres/twres-arkt/images/$img" "/twres/images/"
+        done
+
+        [ -f /ramdisk-files.txt ] && mv -f /ramdisk-files.txt /ramdisk-files-arkt-1.txt
+        [ -f /ramdisk-files-arkt.txt ] && mv -f /ramdisk-files-arkt.txt /ramdisk-files.txt
+        [ -f /ramdisk-files-arkt-1.txt ] && mv -f /ramdisk-files-arkt-1.txt /ramdisk-files-arkt.txt
+        
+        rm -rf /twres/twres-arkt/backup
+    )ArKT";
+
+    Exec_Cmd(swap_script);
