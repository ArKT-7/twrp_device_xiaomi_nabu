+void TWFunc::PartitionByArKT()
+{
+    std::thread([] {
+		gui_print("\nProceeding with Windows partitioning!\n\n");
+        CommonByArKT();
+        std::this_thread::sleep_for(std::chrono::milliseconds(500));
+
+        unsigned long long winend;
+        DataManager::GetValue("win_end_size", winend);
+
+        gui_print("\nMaking partitions stock...");
+        Exec_Cmd("sgdisk --clear --load-backup=/system/bin/gpt0 /dev/block/sda");
+
+        gui_print("\nResizing partition table...");
+        Exec_Cmd("sgdisk --resize-table 64 /dev/block/sda");
+
+        gui_print("\nCreating partitions...");
+        Exec_Cmd("parted -s /dev/block/sda rm 31");
+        Exec_Cmd("parted -s /dev/block/sda mkpart esp fat32 10872MB 11222MB");
+
+        std::string win_end_str = std::to_string(winend) + "MB";
+        Exec_Cmd("parted -s /dev/block/sda mkpart win ntfs 11222MB " + win_end_str);
+        Exec_Cmd("parted -s /dev/block/sda mkpart userdata ext4 " + win_end_str + " 100%");
+        Exec_Cmd("parted -s /dev/block/sda set 31 esp on");
+
+        std::this_thread::sleep_for(std::chrono::milliseconds(300));
+        sync();
+
+        gui_print("\nFormatting userdata(Android)...");
+        Exec_Cmd("make_f2fs -f -g android /dev/block/sda33");
+
+        gui_print("\nFormatting metadata...");
+        Exec_Cmd("mke2fs -t ext4 -F /dev/block/sda19");
+
+        gui_print("\nFormatting ESP Partition...");
+        Exec_Cmd("mkfs.fat -F32 -s1 /dev/block/sda31 -n ESPNABU");
+
+        gui_print("\nFormatting Windows Partition...\n\n");
+        Exec_Cmd("mkfs.ntfs -f /dev/block/sda32 -L WINNABU");
+        sync();
+
+        for (char suffix = 'a'; suffix <= 'f'; ++suffix) {
+            std::string device = "/dev/block/sd";
+            device += suffix;
+
+            gui_print("Fixing GPT on %s...", device.c_str());
+            Exec_Cmd("echo -e \"x\\nj\\n\\nk\\n\\nw\\nY\\n\" | gdisk " + device);
+        }
+
+        sync();
+        PrintPartitionsByArKT();
+        std::this_thread::sleep_for(std::chrono::milliseconds(700));
+        PartitionSizesByArKT();
+    }).detach();
+}
