+
 int GUIAction::flash(std::string arg)
 {
 	int i, ret_val = 0, wipe_cache = 0;
+
+	if (DataManager::GetIntValue("arkt_magic_auto_installer") == 1) {
+		if (checkmagicspacebyarkt("") != 0) {
+			return 0;
+		}
+	}
+
 	// We're going to jump to this page first, like a loading page
 	gui_changePage(arg);
+	if (DataManager::GetIntValue("arkt_magic_auto_installer") == 1) {
+		int magic_ret = 1;
+		const std::string magic_dir = "/sdcard/arkt-magic/";
+		const std::string by_name = "/dev/block/platform/soc/1d84000.ufshc/by-name/";
+
+		operation_start("ArKT Magic Auto-installer flasher");
+		DataManager::SetValue(TW_ZIP_INDEX, 1);
+		DataManager::SetValue("tw_file", TWFunc::Get_Filename(zip_queue[0]));
+
+		if (zip_queue_index != 1) {
+			LOGERR("Error!! Please select only one ZIP file for magic flashing option\n");
+			goto magic_done;
+		}
+
+		{
+			std::string zip_path = zip_queue[0];
+			LOGINFO("ZIP full path: %s\n", zip_path.c_str());
+
+			gui_print("\nStarting Magic Auto-installer flashing...");
+			gui_print("\nChecking for payload.bin in ZIP...");
+			if (TWFunc::Exec_Cmd("unzip -l \"" + zip_path + "\" | grep -q payload.bin", false) != 0) {
+				LOGERR("Error!! ZIP does not contain payload.bin, Not a valid OTA/Recovery ROM ZIP\n");
+				goto magic_done;
+			}
+
+			gui_print("Verifying OTA ZIP contents...\n ");
+			std::string payload_out;
+			if (TWFunc::Exec_Cmd("/system/bin/otaripper -l \"" + zip_path + "\"", payload_out, true) != 0 || payload_out.empty()) {
+				LOGERR("Error!! Failed to analyze the OTA ZIP\n");
+				goto magic_done;
+			}
+
+			std::istringstream stream(payload_out);
+			std::string line;
+			while (std::getline(stream, line)) {
+				gui_print("%s\n", line.c_str());
+			}
+
+			std::vector<std::string> missing;
+			for (const auto& part : arkt_required_parts) {
+				if (payload_out.find(part) == std::string::npos) {
+					missing.push_back(part);
+				}
+			}
+			if (!missing.empty()) {
+				LOGERR("Error!! OTA ZIP is missing the following required images:\n");
+				for (const auto& part : missing) {
+					gui_print("  - %s\n", part.c_str());
+				}
+				goto magic_done;
+			}
+			gui_print("OTA ZIP contains all required images");
+
+			TWFunc::Exec_Cmd("rm -rf " + magic_dir + " && mkdir -p " + magic_dir);
+			gui_print("\nExtracting images directly from ZIP...");
+			if (TWFunc::Exec_Cmd("/system/bin/otaripper -n -o " + magic_dir + " \"" + zip_path + "\"", true) != 0) {
+				LOGERR("Error!! Failed to extract images from OTA ZIP\n");
+				goto magic_done;
+			}
+
+			TWFunc::Exec_Cmd("mv " + magic_dir + "extracted_*/* " + magic_dir + " && rm -rf " + magic_dir + "extracted_*");
+
+			gui_print("Building super.img...");
+			std::string lpmake_cmd = "lpmake "
+				"--metadata-size 65536 "
+				"--metadata-slots 3 "
+				"--device super:9126805504 "
+				"--super-name super "
+				"--group super_group_a:9126805504 "
+				"--group super_group_b:9126805504 ";
+
+			std::vector<std::string> super_parts = {"odm", "product", "system", "system_ext", "vendor"};
+			for (const auto& part : super_parts) {
+				std::string part_path = magic_dir + part + ".img";
+				uint64_t sz = get_img_size(part_path);
+				if (sz == 0) {
+					LOGERR("Error!! Failed to get size of %s.img\n", part.c_str());
+					goto magic_done;
+				}
+
+				lpmake_cmd += "--partition " + part + "_a:readonly:" + std::to_string(sz) + ":super_group_a "
+							+ "--image " + part + "_a=" + part_path + " "
+							+ "--partition " + part + "_b:readonly:0:super_group_b ";
+			}
+
+			lpmake_cmd += "--virtual-ab --output " + magic_dir + "super.img";
+			if (TWFunc::Exec_Cmd(lpmake_cmd, true) != 0) {
+				LOGERR("Error!! lpmake failed to create super.img\n");
+				goto magic_done;
+			}
+
+			for (const auto& part : super_parts) {
+				unlink((magic_dir + part + ".img").c_str());
+			}
+			gui_print("super.img built successfully");
+
+			gui_print("\nFlashing images to device partitions...");
+			std::vector<std::string> flash_parts = {
+				"boot", "dtbo", "vbmeta", "vbmeta_system", "vendor_boot", "super"
+			};
+
+			for (const auto& part : flash_parts) {
+				std::string img_path = magic_dir + part + ".img";
+				uint64_t sz = get_img_size(img_path);
+				if (sz == 0) {
+					LOGERR("Error!! Failed to get size of %s.img\n", part.c_str());
+					goto magic_done;
+				}
+
+				if (part == "super") {
+					gui_print("Flashing super.img to super partition...");
+					std::string cmd = "pv -s " + std::to_string(sz) + " \"" + img_path + "\" > \"" + by_name + "super\"";
+					if (TWFunc::Exec_Cmd(cmd, true) != 0) {
+						LOGERR("Error!! Failed to flash super.img\n");
+						goto magic_done;
+					}
+				} else {
+					for (const auto& slot : {"_a", "_b"}) {
+						std::string target = part + slot;
+						gui_print("Flashing %s.img to %s...", part.c_str(), target.c_str());
+						std::string cmd = "pv -s " + std::to_string(sz) + " \"" + img_path + "\" > \"" + by_name + target + "\"";
+						if (TWFunc::Exec_Cmd(cmd, true) != 0) {
+							LOGERR("Error!! Failed to flash %s.img to %s\n", part.c_str(), target.c_str());
+							goto magic_done;
+						}
+					}
+				}
+			}
+
+			gui_print("\nMagic Flashing completed!");
+			gui_print("\nIf Clean Install/Not updating: Make sure to Format/Wipe data!\n ");
+			PartitionManager.Set_Active_Slot("A");
+			magic_ret = 0;
+		}
+
+magic_done:
+		zip_queue_index = 0;
+		DataManager::SetValue(TW_ZIP_QUEUE_COUNT, 0);
+		DataManager::SetValue("arkt_magic_auto_installer", 0);
+		TWFunc::Exec_Cmd("rm -rf " + magic_dir, false);
+		operation_end(magic_ret);
+		return magic_ret;
+	}
+
