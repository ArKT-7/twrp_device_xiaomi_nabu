+int GUIAction::checkmagicspacebyarkt(std::string arg __unused)
+{
+    if (DataManager::GetIntValue("arkt_magic_auto_installer") != 1)
+        return 0;
+
+    std::string zip_path = zip_queue[0];
+    if (zip_path.empty())
+        return 0;
+
+    double total_gb = 0.0;
+    std::string out;
+    if (TWFunc::Exec_Cmd("/system/bin/otaripper -l \"" + zip_path + "\"", out, true) == 0) {
+        std::istringstream stream(out);
+        std::string line, part, unit;
+        double size = 0.0;
+
+        while (std::getline(stream, line)) {
+            std::istringstream ls(line);
+            if (!(ls >> part >> size >> unit))
+                continue;
+
+            if (std::find(arkt_required_parts.begin(), arkt_required_parts.end(), part) != arkt_required_parts.end()) {
+                if (unit == "GiB" || unit == "GB") total_gb += size;
+                else if (unit == "MiB" || unit == "MB") total_gb += size / 1024.0;
+                else if (unit == "KiB" || unit == "KB") total_gb += size / (1024.0 * 1024.0);
+            }
+        }
+    }
+
+    double req_gb = (total_gb > 0.0) ? (total_gb * 2.0) : 14.0;
+    double free_gb = 0.0;
+
+    struct statvfs vfs;
+    if (statvfs("/sdcard", &vfs) == 0)
+        free_gb = ((double)vfs.f_bavail * vfs.f_frsize) / (1024.0 * 1024.0 * 1024.0);
+
+    char free_buf[32], req_buf[32];
+    snprintf(free_buf, sizeof(free_buf), "%.1f GB", free_gb);
+    snprintf(req_buf, sizeof(req_buf), "%.1f GB", req_gb);
+
+    DataManager::SetValue("arkt_free_space", free_buf);
+    DataManager::SetValue("arkt_required_space", req_buf);
+
+    if (free_gb < req_gb) {
+        gui_changeOverlay("magic_space_warn");
+        return 1;
+    }
+    return 0;
+}
+
+int GUIAction::installbyarkt(std::string arg __unused)
+{
+    std::string filepath;
+    DataManager::GetValue("tw_filename", filepath);
+    std::string filename = TWFunc::Get_Filename(filepath);
+
+    std::string ext = "";
+    size_t pos = filename.find_last_of(".");
+    if (pos != std::string::npos)
+        ext = filename.substr(pos);
+
+    if (ext == ".img" || ext == ".IMG") {
+        DataManager::SetValue("tw_is_slot_part", 0);
+        DataManager::SetValue("tw_flash_both_slots", 1);
+
+        std::string lower_name = filename;
+        std::transform(lower_name.begin(), lower_name.end(), lower_name.begin(), ::tolower);
+        std::string target_partition = "";
+
+        if (lower_name.find("vendor_boot") != std::string::npos) {
+            target_partition = "/vendor_boot;"; 
+        } else if (lower_name.find("boot") != std::string::npos) {
+            target_partition = "/boot;";
+        } else if (lower_name.find("dtbo") != std::string::npos) {
+            target_partition = "/dtbo;";
+        } else if (lower_name.find("super") != std::string::npos) {
+            target_partition = "/super;";
+        } else if (lower_name.find("persist") != std::string::npos) {
+            target_partition = "/persist;";
+        }
+
+        DataManager::SetValue("tw_flash_partition", target_partition);
+        gui_changePage("flashimage_confirm");
+
+    } else {
+        bool has_payload = (TWFunc::Exec_Cmd("unzip -l \"" + filepath + "\" | grep -q payload.bin", false) == 0);
+        DataManager::SetValue("tw_zip_has_payload", has_payload ? 1 : 0);
+        DataManager::SetValue("arkt_magic_auto_installer", has_payload ? 1 : 0);
+
+        queuezip(""); 
+        gui_changePage("flash_confirm");
+    }
+    return 0;
+}
