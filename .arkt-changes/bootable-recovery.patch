+void TWFunc::CommonByArKT() 
+{
+    std::string usb_config = android::base::GetProperty("sys.usb.config", "");
+    if (usb_config.find("mtp") != std::string::npos) {
+        gui_print("\nMTP mode detected, resetting USB to ADB...");
+        PartitionManager.Disable_MTP();
+        android::base::SetProperty("sys.usb.config", "none");
+        android::base::SetProperty("sys.usb.config", "adb");
+        Exec_Cmd("rm -f /config/usb_gadget/g1/configs/b.1/f* || true");
+        std::this_thread::sleep_for(std::chrono::milliseconds(500));
+    }
+
+    gui_print("\nUnmounting all required partitions...");
+
+    const std::string umount_script = R"ArKT(
+        for i in sdcard data; do umount -lf /$i 2>/dev/null || true; done
+        dmsetup remove -f userdata 2>/dev/null || true
+        for i in esp win linux firmware mnt userdata metadata misc vendor; do umount -lf /dev/block/platform/soc/1d84000.ufshc/by-name/$i > /dev/null 2>&1 || true; done
+    )ArKT";
+    
+    Exec_Cmd(umount_script);
+}
